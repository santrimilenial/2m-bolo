DELETE FROM "AdAccount" aa
USING tmp_ad_accounts_migration t, "SalesSource" ss
WHERE ss."name" = t.source_name
  AND aa."sourceId" = ss."id"
  AND aa."accountName" = t.account_name;

INSERT INTO "AdAccount" (
  "id",
  "sourceId",
  "groupName",
  "accountName",
  "productInfo",
  "status",
  "createdAt",
  "updatedAt"
)
SELECT
  gen_random_uuid()::text,
  ss."id",
  t.group_name,
  t.account_name,
  t.product_info,
  t.status,
  NOW(),
  NOW()
FROM tmp_ad_accounts_migration t
JOIN "SalesSource" ss ON ss."name" = t.source_name;

-- Validasi hasil insert untuk daftar migrasi ini
DO $$
DECLARE
  expected_count INT := 62;
  actual_count INT;
BEGIN
  SELECT COUNT(*) INTO actual_count
  FROM "AdAccount" aa
  JOIN "SalesSource" ss ON ss."id" = aa."sourceId"
  JOIN tmp_ad_accounts_migration t
    ON t.source_name = ss."name"
   AND t.account_name = aa."accountName";

  IF actual_count <> expected_count THEN
    RAISE EXCEPTION 'Jumlah AdAccount hasil migrasi tidak sesuai. Expected %, actual %', expected_count, actual_count;
  END IF;
END $$;

